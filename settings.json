{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git fetch:*)", "Bash(git add:*)", "Bash(git stash:*)",
      "Bash(ls:*)", "Bash(pwd)", "Bash(wc:*)", "Bash(which:*)", "Bash(tree:*)",
      "Bash(npm test:*)", "Bash(npm run test:*)", "Bash(npm run lint:*)", "Bash(npm run build:*)", "Bash(npm run typecheck:*)",
      "Bash(bun test:*)", "Bash(bun run test:*)", "Bash(bun run lint:*)", "Bash(bun run typecheck:*)", "Bash(bun run build:*)",
      "Bash(pytest:*)", "Bash(python -m pytest:*)", "Bash(ruff check:*)", "Bash(mypy:*)",
      "Bash(cargo test:*)", "Bash(cargo check:*)", "Bash(cargo clippy:*)", "Bash(go test:*)", "Bash(go vet:*)",
      "Bash(shellcheck:*)", "Bash(jq:*)"
    ],
    "ask": [
      "Bash(git commit:*)", "Bash(git push:*)", "Bash(git merge:*)", "Bash(git rebase:*)",
      "Bash(git reset:*)", "Bash(git checkout -- :*)", "Bash(git clean:*)",
      "Bash(npm install:*)", "Bash(npm publish:*)", "Bash(pip install:*)",
      "Bash(docker:*)", "Bash(kubectl:*)", "Bash(terraform apply:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)", "Bash(sudo:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push * --force:*)",
      "Bash(git commit --no-verify:*)", "Bash(git commit -n:*)",
      "Bash(curl * | sh:*)", "Bash(curl * | bash:*)", "Bash(wget * | sh:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/*.pem)", "Read(**/*.key)", "Read(**/id_rsa*)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Edit(./.env)", "Edit(./.env.*)", "Write(./.env)", "Write(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/guard-bash.sh" }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/guard-secrets.sh" }]
      }
    ]
  }
}
